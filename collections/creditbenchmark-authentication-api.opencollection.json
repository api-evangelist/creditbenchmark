{
  "opencollection": "1.0.0",
  "info": {
    "name": "Credit Benchmark Analytics Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create JWT Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.creditbenchmark.com/gartan/api/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "Username",
                  "value": ""
                },
                {
                  "name": "Password",
                  "value": ""
                },
                {
                  "name": "grant_type",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Create a JWT bearer token.\n"
        }
      ]
    }
  ],
  "bundled": true
}